name: Build DHIQAR TV APK

on:
  push:
    branches:
      - main
      - master
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    name: Build Android APK
    runs-on: ubuntu-latest

    steps:

      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Find DHIQAR TV ZIP
        shell: bash
        run: |
          set -e

          echo "Searching for DHIQAR TV ZIP..."

          ZIP_FILE=""

          if [ -f "DHIQAR-TV-V5-PRO-FULL.zip" ]; then
            ZIP_FILE="DHIQAR-TV-V5-PRO-FULL.zip"
          else
            ZIP_FILE=$(find . -maxdepth 3 -type f \
              \( -iname "*DHIQAR*TV*.zip" -o -iname "*.zip" \) \
              | head -n 1 || true)
          fi

          if [ -z "$ZIP_FILE" ]; then
            echo "ERROR: No ZIP project found."
            exit 1
          fi

          echo "Using ZIP: $ZIP_FILE"

          mkdir -p extracted
          unzip -o "$ZIP_FILE" -d extracted

          echo "Extracted files:"
          find extracted -maxdepth 4 -type f | head -100

      - name: Locate Android project
        shell: bash
        run: |
          set -e

          PROJECT_DIR=""

          for DIR in \
            "extracted/DHIQAR-TV-v5-PRO" \
            "extracted/DHIQAR-TV-V5-PRO" \
            "extracted/DHIQAR-TV" \
            "extracted"
          do
            if [ -f "$DIR/settings.gradle" ] && [ -f "$DIR/app/build.gradle" ]; then
              PROJECT_DIR="$DIR"
              break
            fi
          done

          if [ -z "$PROJECT_DIR" ]; then
            PROJECT_DIR=$(find extracted -type f -name "settings.gradle" \
              -printf '%h\n' | head -n 1 || true)
          fi

          if [ -z "$PROJECT_DIR" ]; then
            echo "ERROR: Android project not found."
            find extracted -maxdepth 6 -type f
            exit 1
          fi

          echo "Android project:"
          echo "$PROJECT_DIR"

          echo "PROJECT_DIR=$PROJECT_DIR" >> "$GITHUB_ENV"

      - name: Build DHIQAR TV
        shell: bash
        run: |
          set -e

          cd "$PROJECT_DIR"

          echo "======================================"
          echo " DHIQAR TV Android Build"
          echo "======================================"

          echo "Project directory:"
          pwd

          echo ""
          echo "Project files:"
          find . -maxdepth 3 -type f | sort

          echo ""
          echo "Building APK..."

          gradle --no-daemon \
            --stacktrace \
            :app:assembleDebug

      - name: Verify APK
        shell: bash
        run: |
          set -e

          APK="$PROJECT_DIR/app/build/outputs/apk/debug/app-debug.apk"

          if [ ! -f "$APK" ]; then
            echo "ERROR: APK was not created."
            find "$PROJECT_DIR/app/build/outputs" -type f 2>/dev/null || true
            exit 1
          fi

          echo "======================================"
          echo " APK CREATED SUCCESSFULLY"
          echo "======================================"

          ls -lh "$APK"

      - name: Rename APK
        shell: bash
        run: |
          mkdir -p release

          cp "$PROJECT_DIR/app/build/outputs/apk/debug/app-debug.apk" \
             "release/DHIQAR-TV-V5-debug.apk"

          ls -lh release/DHIQAR-TV-V5-debug.apk

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: DHIQAR-TV-V5-APK
          path: release/DHIQAR-TV-V5-debug.apk
          if-no-files-found: error
